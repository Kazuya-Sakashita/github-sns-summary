generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GithubEvent {
  id        String    @id @default(cuid())
  repoName  String
  prNumber  Int
  prTitle   String
  prUrl     String
  mergedBy  String?
  rawPayload Json
  createdAt DateTime  @default(now())
  posts     SnsPost[]
}

model SnsPost {
  id           String      @id @default(cuid())
  eventId      String
  event        GithubEvent @relation(fields: [eventId], references: [id])
  platform     String      // "x", "bluesky", "webhook" など
  content      String
  status       String      // "SUCCESS" | "FAILED"
  externalId   String?
  errorMessage String?
  createdAt    DateTime    @default(now())
}
