// ==================== Datasource ====================
datasource db {
  provider = "sqlite"
  // Prisma 7 では接続URLは prisma.config.ts 側で指定
}

// ==================== Generator ====================
generator client {
  provider = "prisma-client-js"
}

// ==================== Enums ====================

// Webhook 受信ログの処理ステータス
enum WebhookDeliveryStatus {
  RECEIVED   // 受信してログは作った（処理前）
  PROCESSED  // 本処理まで成功
  FAILED     // 本処理が失敗
  IGNORED    // 対象外イベントなどで処理しなかった
}

// ==================== Models ====================

// アプリ内ユーザー
model User {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  events GithubEvent[]
}

// ==================== GitHub Event ====================
// PR を軸に、要約・分析に使う情報を集約する中核テーブル
model GithubEvent {
  id String @id @default(cuid())

  // Webhook 冪等性キー
  githubDeliveryId String @unique

  // マルチテナント（フェーズ1では OWNER_USER_ID を想定）
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // PR 基本情報（Webhook payload 由来）
  repoName       String   // "owner/repo"
  prNumber       Int
  prTitle        String
  prUrl          String
  mergedBy       String?
  mergedAt       DateTime?
  mergeCommitSha String?

  // Webhook payload を保持（調査・再処理用）
  rawPayload Json

  // =========================
  // #35: PR 詳細（GitHub API 補完）
  // =========================
  prAuthor     String?    // PR 作成者 login
  prBody       String?    // PR 本文（description）
  prLabels     Json?      // ["bug","feature"] など（name のみ）
  prFetchedAt  DateTime?
  prFetchError String?

  // =========================
  // #36: 変更ファイル集計（SNS要約向け）
  // =========================
  prFilesCount Int?
  prAdditions  Int?
  prDeletions  Int?

  // 拡張子 / レイヤー / 種別など自由に使える集計
  // 例: { ".ts": 3, "prisma": 2, "noext": 1 }
  prFileStats Json?
  prChanges    Int?

  createdAt DateTime @default(now())

  // relations
  posts             SnsPost[]
  webhookDeliveries GithubWebhookDelivery[]
  prFiles           GithubPullRequestFile[]

  // 同一PRの収束
  @@unique([userId, repoName, prNumber])
  @@index([userId, createdAt])
  @@index([repoName, prNumber])
  @@index([prFetchedAt])
}

// ==================== PR Changed Files ====================
// pulls/{number}/files の内容を保持
model GithubPullRequestFile {
  id String @id @default(cuid())

  eventId String
  event   GithubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  filename  String
  status    String   // "added" | "modified" | "removed" | "renamed" など
  additions Int
  deletions Int
  changes   Int

  // ".ts" / ".prisma" / null（拡張子なし）
  extension String?

  createdAt DateTime @default(now())

  // 同一 PR 内の同一ファイルは upsert 対象
  @@unique([eventId, filename])
  @@index([eventId])
  @@index([extension])
}

// ==================== Webhook Delivery Log ====================
model GithubWebhookDelivery {
  id String @id @default(cuid())

  deliveryId String @unique      // x-github-delivery
  eventName  String              // x-github-event
  signature256 String?

  receivedAt DateTime @default(now())

  status        WebhookDeliveryStatus @default(RECEIVED)
  attemptCount  Int @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  errorMessage  String?

  githubEventId String?
  githubEvent   GithubEvent? @relation(fields: [githubEventId], references: [id])

  rawPayload Json

  @@index([eventName, receivedAt])
  @@index([githubEventId])
  @@index([status, receivedAt])
}

// ==================== SNS Post Log ====================
model SnsPost {
  id String @id @default(cuid())

  eventId String
  event   GithubEvent @relation(fields: [eventId], references: [id])

  platform     String   // "webhook" | "x" | "bluesky" など
  content      String
  status       String   // "SUCCESS" | "FAILED" | "SKIPPED"
  externalId   String?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}
